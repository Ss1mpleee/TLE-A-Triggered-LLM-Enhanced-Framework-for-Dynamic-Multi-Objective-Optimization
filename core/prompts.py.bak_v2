"""
Prompt Templates for LLM-Orchestrated EA
=========================================
Two-channel prompt design:
  Channel 1 (strategic): {strategy, subspace_indices, crossover_mode}
  Channel 2 (parametric): {F, CR, pop_size_delta}
"""
import json
from typing import Dict, Any, Optional, Tuple, List
import numpy as np

from .llm_interface import LLMClient


SYSTEM_PROMPT = """You are an expert in evolutionary computation, particularly
differential evolution (DE) for multi-objective optimization. You provide
real-time strategic advice during evolutionary search based on population
statistics.

Your output must be a JSON object with exactly two channels:
- "strategy": either "exploit" (intensify current best region),
               "explore" (broaden search to new regions),
               or "focus" (concentrate on a subset of variables).
- "subspace_indices": list of integer indices [0, D-1] of variables to
                      focus on (empty list means all variables).
- "crossover_mode": either "binomial" or "exponential".
- "F": scaling factor in [0.1, 1.0] (recommended 0.4-0.9).
- "CR": crossover rate in [0.1, 1.0] (recommended 0.6-0.95).
- "pop_size_delta": integer change in population size, range [-30, 30].
- "reasoning": one-sentence explanation of your recommendation.

Respond ONLY with valid JSON. No markdown, no extra text."""


# ==================== Multi-Action Controller Prompt (A3) ====================
SYSTEM_PROMPT_MULTI_ACTION = """You are an expert controller for dynamic
multi-objective evolutionary optimization. You select ONE structural
algorithmic intervention at each decision point, based on the current
population state, environmental change signal, and history of past
interventions.

Choose exactly ONE of these four actions. Pick the one whose semantics
match the diagnosed condition:

1. "param"  - Tune DE parameters (F, CR, strategy). Use when the population
              is healthy AND making progress (best fitness decreasing over
              recent generations) but convergence is slow or oscillating.
              This is the lightest intervention; it does NOT change which
              individuals exist, only how new ones are generated.
              DEFAULT CHOICE when uncertain - safe and rarely destructive.
              params: {strategy: "rand"|"best"|"current_to_best",
                       F: 0.1-1.0, CR: 0.1-1.0}

2. "archive_reset" - Reset or trim the non-dominated archive and seed
              fresh individuals. Use ONLY when the population is NOT making
              progress AND there was a major environmental change.
              WARNING: This is destructive; do not use if best fitness is
              still decreasing. By default, use small trim_pct (10-20%).
              params: {mode: "all"|"trim"|"replace_worst",
                       trim_pct: 5-30 (percent to reset; 15 default,
                                       stay LOW to preserve progress)}

3. "restart_top" - Re-initialize the top X% of individuals around the
              current best with controlled noise. Use when the population
              has STAGNATED around a sub-optimal region for several
              generations and you want to restart convergence around the
              best known point without losing its location.
              params: {restart_pct: 5-20 (percent to restart; 10 default),
                       around: "best"|"current_center",
                       noise_scale: 0.01-0.1 (small noise to preserve location)}

4. "diversity_injection" - Inject K new individuals to maintain diversity.
              Use ONLY when population diversity is critically low (top
              individuals clustered) AND best fitness has plateaued.
              Otherwise use param instead.
              params: {n_inject: 5-20 (number to inject; 10 default),
                       around: "random"|"best"|"anti_best",
                       noise_scale: 0.1-0.3}

KEY DECISION RULE: Look at the recent fitness trajectory. If best_fitness
is STILL DECREASING, prefer "param" (don't disturb progress). Only use
the other three actions if progress has stalled or reversed.

Output JSON ONLY with this exact schema:
{
  "action_type": "param|archive_reset|restart_top|diversity_injection",
  "params": { ...action-specific params... },
  "reasoning": "one-sentence explanation citing the trajectory observation"
}

Respond ONLY with valid JSON. No markdown, no extra text, no preamble."""


def build_population_summary(
    population: np.ndarray,
    fitness: np.ndarray,
    bounds: Tuple[np.ndarray, np.ndarray],
) -> str:
    """Build a compact text summary of population state."""
    NP, D = population.shape
    M = fitness.shape[1] if fitness.ndim == 2 else 1

    # Population stats per dimension
    pop_mean = np.mean(population, axis=0)
    pop_std = np.std(population, axis=0)
    pop_min = np.min(population, axis=0)
    pop_max = np.max(population, axis=0)

    # Normalize to [0,1] range for easier interpretation
    lower, upper = bounds
    norm_mean = (pop_mean - lower) / (upper - lower + 1e-12)
    norm_std = pop_std / (upper - lower + 1e-12)

    # Top-3 individuals (by sum of objectives for multi-objective)
    if fitness.ndim == 2:
        score = np.sum(fitness, axis=1)
    else:
        score = fitness
    top3_idx = np.argsort(score)[:3]

    # Build prompt
    lines = [
        f"Population size: {NP}, Dimensions: {D}, Objectives: {M}",
        f"Current generation statistics:",
    ]
    for d in range(min(D, 10)):  # show first 10 dims
        lines.append(
            f"  x[{d}]: mean={norm_mean[d]:.2f}, std={norm_std[d]:.3f}, "
            f"range=[{pop_min[d]:.2f}, {pop_max[d]:.2f}]"
        )
    if D > 10:
        lines.append(f"  ... (omitted {D - 10} dimensions)")

    lines.append("")
    lines.append(f"Top-3 individuals (lower is better for minimization):")
    for rank, idx in enumerate(top3_idx):
        if fitness.ndim == 2:
            obj_str = ", ".join([f"f{j}={fitness[idx, j]:.3f}" for j in range(M)])
        else:
            obj_str = f"f={fitness[idx]:.3f}"
        lines.append(f"  rank {rank+1}: {obj_str}, x_norm[0:3]={norm_mean[0:3].tolist()}")

    lines.append("")
    lines.append(f"Total objective range: min={np.min(score):.3f}, max={np.max(score):.3f}")

    return "\n".join(lines)


def build_change_signal_info(change_signal: Optional[float],
                              trigger_info: Dict[str, Any]) -> str:
    """Add environmental change info if available."""
    if change_signal is None and not trigger_info.get("signal_3_change"):
        return ""
    lines = [
        "",
        "Environmental change detected! The optimization landscape has shifted.",
        "Recommend a strategy that adapts to new conditions.",
    ]
    return "\n".join(lines)


def call_llm_for_advice(
    llm: LLMClient,
    population: np.ndarray,
    fitness: np.ndarray,
    bounds: Tuple[np.ndarray, np.ndarray],
    generation: int,
    trigger_info: Optional[Dict[str, Any]] = None,
    change_signal: Optional[float] = None,
) -> Dict[str, Any]:
    """
    Query LLM for strategic + parametric advice.

    Returns dict with keys: strategy, subspace_indices, crossover_mode,
                            F, CR, pop_size_delta, reasoning.
    """
    # Build prompt
    pop_summary = build_population_summary(population, fitness, bounds)
    change_info = build_change_signal_info(change_signal, trigger_info or {})

    user_prompt = f"""Current generation: {generation}

{pop_summary}
{change_info}

Based on the above population state, provide your strategic and parametric
recommendation for the next few generations of differential evolution.

Output JSON only."""

    response = llm.call(user_prompt, system=SYSTEM_PROMPT, temperature=0.0,
                        max_tokens=300, force_json=True)
    parsed = llm.parse_json(response)

    if parsed is None:
        return _default_advice()

    # Validate & clamp
    return _validate_advice(parsed)


# ==================== Multi-Action Controller (A3) ====================

def build_action_history_block(history: Optional[List[Dict[str, Any]]]) -> str:
    """
    Format the last N actions and their measured reward into a compact block
    for the LLM prompt. Helps the LLM learn from past decisions.
    """
    if not history:
        return ""
    lines = ["", "Recent action history (most recent first):"]
    for i, h in enumerate(history[-5:][::-1]):
        try:
            action_type = h.get("action_type", "?")
            params_str = str(h.get("params", {}))[:80]
            reward = h.get("reward", 0.0)
            gen = h.get("gen", "?")
            lines.append(f"  gen {gen}: {action_type} {params_str} -> reward={reward:+.3f}")
        except Exception:
            continue
    return "\n".join(lines)


def call_llm_for_multi_action(
    llm: LLMClient,
    population: np.ndarray,
    fitness: np.ndarray,
    bounds: Tuple[np.ndarray, np.ndarray],
    generation: int,
    trigger_info: Optional[Dict[str, Any]] = None,
    change_signal: Optional[float] = None,
    action_history: Optional[List[Dict[str, Any]]] = None,
    best_fitness_history: Optional[List[float]] = None,
) -> Dict[str, Any]:
    """
    Query LLM for one of 4 multi-action controller interventions.

    Returns dict with keys: action_type, params, reasoning.
    Falls back to default_action() on parse failure.
    """
    from .multi_action import default_action

    pop_summary = build_population_summary(population, fitness, bounds)
    change_info = build_change_signal_info(change_signal, trigger_info or {})
    history_block = build_action_history_block(action_history)
    progress_block = build_progress_block(best_fitness_history)

    user_prompt = f"""Current generation: {generation}

{pop_summary}
{change_info}
{progress_block}
{history_block}

Choose ONE of the four actions (param / archive_reset / restart_top /
diversity_injection) and provide its parameters.

Output JSON only."""

    response = llm.call(
        user_prompt,
        system=SYSTEM_PROMPT_MULTI_ACTION,
        temperature=0.0,
        max_tokens=400,
        force_json=True,
    )
    parsed = llm.parse_json(response)

    if parsed is None:
        d = default_action()
        return d.to_dict()

    from .multi_action import parse_llm_response_to_action
    action = parse_llm_response_to_action(parsed)
    if action is None or not action.is_valid():
        d = default_action()
        return d.to_dict()

    return action.to_dict()


def build_progress_block(best_fitness_history: Optional[List[float]]) -> str:
    """
    Build a compact progress block showing best fitness trajectory over
    recent generations. This helps the LLM decide whether the population
    is still improving (param is safe) or has stalled (other actions OK).
    """
    if not best_fitness_history:
        return ""
    # Show last 10 gens + delta
    recent = best_fitness_history[-10:]
    lines = ["", "Best fitness trajectory (last %d generations, lower=better):" % len(recent)]
    for i, v in enumerate(recent):
        bar = "#" * max(0, min(40, int((1.5 - v) * 20))) if v < 1.5 else ""
        lines.append(f"  gen-{len(recent)-i}: {v:.4f} {bar}")
    # Trend: positive if decreasing (improving)
    if len(recent) >= 3:
        delta = recent[-1] - recent[0]
        trend = "IMPROVING" if delta < -0.001 else ("STALLED" if abs(delta) < 0.005 else "WORSENING")
        lines.append(f"  Trend over last {len(recent)} gens: delta={delta:+.4f} -> {trend}")
    return "\n".join(lines)


def _default_advice() -> Dict[str, Any]:
    """Conservative default if LLM fails."""
    return {
        "strategy": "exploit",
        "subspace_indices": [],
        "crossover_mode": "binomial",
        "F": 0.5,
        "CR": 0.9,
        "pop_size_delta": 0,
        "reasoning": "default (LLM unavailable)",
    }


def _validate_advice(raw: Dict[str, Any]) -> Dict[str, Any]:
    """Validate and clamp LLM output to valid ranges."""
    out = _default_advice()

    # Strategy
    s = raw.get("strategy", "exploit")
    if s in ("exploit", "explore", "focus"):
        out["strategy"] = s

    # Subspace indices
    indices = raw.get("subspace_indices", [])
    if isinstance(indices, list):
        out["subspace_indices"] = [int(i) for i in indices if isinstance(i, (int, float)) and i >= 0]

    # Crossover mode
    cm = raw.get("crossover_mode", "binomial")
    if cm in ("binomial", "exponential"):
        out["crossover_mode"] = cm

    # F
    F = raw.get("F", 0.5)
    try:
        F = float(F)
        out["F"] = np.clip(F, 0.1, 1.0)
    except Exception:
        pass

    # CR
    CR = raw.get("CR", 0.9)
    try:
        CR = float(CR)
        out["CR"] = np.clip(CR, 0.1, 1.0)
    except Exception:
        pass

    # pop_size_delta
    delta = raw.get("pop_size_delta", 0)
    try:
        delta = int(delta)
        out["pop_size_delta"] = int(np.clip(delta, -30, 30))
    except Exception:
        pass

    out["reasoning"] = str(raw.get("reasoning", ""))[:200]
    return out


def apply_advice(population: np.ndarray, advice: Dict[str, Any],
                 bounds: Tuple[np.ndarray, np.ndarray]) -> Tuple[np.ndarray, Dict[str, Any]]:
    """
    Apply LLM's strategic advice to the population.

    Returns:
        modified_population, applied_actions_dict
    """
    NP, D = population.shape
    lower, upper = bounds
    actions = {}

    # Action 1: Strategy -> operator selection
    strategy = advice.get("strategy", "exploit")
    if strategy == "exploit":
        actions["de_strategy"] = "best"
    elif strategy == "explore":
        actions["de_strategy"] = "rand"
    else:  # focus
        actions["de_strategy"] = "current_to_best"
    actions["F"] = advice.get("F", 0.5)
    actions["CR"] = advice.get("CR", 0.9)
    actions["crossover_mode"] = advice.get("crossover_mode", "binomial")

    # Action 2: Subspace focusing
    # If LLM specifies subspace indices, we restrict DE to those dimensions
    # by setting CR=0 outside those dimensions
    subspace = advice.get("subspace_indices", [])
    if subspace and strategy == "focus":
        # Create a CR mask
        cr_mask = np.zeros(D)
        valid = [i for i in subspace if 0 <= i < D]
        for i in valid:
            cr_mask[i] = 1.0
        actions["cr_mask"] = cr_mask
    else:
        actions["cr_mask"] = None

    # Action 3: Population size change
    delta = advice.get("pop_size_delta", 0)
    if delta != 0:
        new_NP = max(20, min(300, NP + delta))
        if new_NP > NP:
            # Add new individuals via random sampling
            extra = np.random.uniform(lower, upper, (new_NP - NP, D))
            population = np.vstack([population, extra])
        elif new_NP < NP:
            # Remove worst individuals (random removal for simplicity)
            idx = np.random.choice(NP, new_NP, replace=False)
            population = population[idx]
        actions["new_pop_size"] = new_NP
    else:
        actions["new_pop_size"] = NP

    return population, actions
